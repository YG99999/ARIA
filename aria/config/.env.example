# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# LLM API (OpenAI-compatible — works with OpenRouter, Anthropic proxy, etc.)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Browser
BROWSER_HEADLESS=true
# Set to false on Windows/macOS dev machine to watch the browser
# DISPLAY is set automatically on Linux; do not set here

# Optional: CapSolver API for CAPTCHA solving (disabled by default)
# CAPSOLVER_KEY=your_capsolver_key

# Optional: Tailscale IP for VNC handover
# TAILSCALE_IP=100.x.x.x

# Webhook secrets (HMAC-SHA256 per source)
# WEBHOOK_SECRET_GITHUB=your_github_webhook_secret
# WEBHOOK_SECRET_STRIPE=your_stripe_webhook_secret

# Semantic memory (deferred — FTS5 fallback used when false)
SEMANTIC_MEMORY=false

# Data directory (absolute path; defaults to ./data relative to aria/)
# DATA_DIR=

# Skills directory (absolute path; defaults to ./skills relative to aria/)
# SKILLS_DIR=
